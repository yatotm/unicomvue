# 本地启动自动读取本文件，系统环境变量优先；开发代理自动跟随端口
# Docker Compose 会覆盖为 0.0.0.0:8788，容器端口无需随宿主机改变
HOST=127.0.0.1
PORT=8788

# 额外允许的前端来源，逗号分隔；留空只允许同源浏览器请求
ALLOWED_ORIGINS=

# 直连时留空；代理后填写可信代理 IP/CIDR 或跳数；Compose 自动设置为 1
TRUST_PROXY=

# 前端需配置同样的 VITE_API_ACCESS_TOKEN，该值对网页访问者可见
# 公网部署请另外配置 VPN 或反向代理认证，不能把此值当作站点密码
ACCESS_TOKEN=

# 仅诊断时开启：_raw 可能包含完整手机号和凭证，分享前必须脱敏
DEBUG_RAW=false

# 上游
UNICOM_BASE_URL=https://m.client.10010.com
UNICOM_LOGIN_BASE_URL=https://loginxhm.10010.com
UNICOM_APP_VERSION=android@13.0000
UNICOM_APP_ID=ChinaunicomMobileBusiness
UNICOM_TIMEOUT_MS=15000

# 登录域名和版本参考当前官方 Android 客户端；查询路径已用真实账号实测通过。
UNICOM_SEND_SMS_PATH=/mobileService/sendRadomNum.htm
UNICOM_LOGIN_PATH=/mobileService/radomLogin.htm
UNICOM_PASSWORD_LOGIN_PATH=/mobileService/login.htm
UNICOM_OCS_PATH=/servicequerybusiness/operationservice/queryOcsPackageFlowLeftContentRevisedInJune
UNICOM_BASIC_DATA_PATH=/servicebusiness/query/fiveg/getbasicdata
UNICOM_QCI_PATH=/servicebusiness/newOrdered/queryOrderRelationship

# 短信频率上限（每小时）
SMS_LIMIT_PER_PHONE_HOUR=5
SMS_LIMIT_PER_IP_HOUR=10
LOGIN_LIMIT_PER_PHONE_HOUR=20
LOGIN_LIMIT_PER_IP_HOUR=60
CAPTCHA_LIMIT_PER_IP_HOUR=60

# 网关额外的腾讯云验证码，与联通官方身份验证独立；官方验证页无需开启此项。
# 开启必须用你自己注册的应用，
# AppID 由后端返回给前端，密钥只保留在后端。
CAPTCHA_ENABLED=false
CAPTCHA_APP_ID=
CAPTCHA_APP_SECRET=
CAPTCHA_TIMEOUT_MS=10000
