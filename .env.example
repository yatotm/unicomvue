# 以下三个 VITE_ 变量在构建时编译进产物，只对本地构建生效；
# 直接拉取已发布镜像时它们不起作用，需要 docker compose up -d --build。

# 留空 = 同源请求（推荐）：由 nginx 把 /gettoken/ 和三个 *_proxy/ 反代到后端。
# 填写完整地址则直连指定后端，例如 https://api.example.com
VITE_API_BASE_URL=

# 此值会打包进浏览器 JS，不能代替 VPN、反向代理认证等站点访问控制
# 后端设置了 ACCESS_TOKEN 时填写相同的值
VITE_API_ACCESS_TOKEN=

# 自建后端会返回自己的验证码 AppID；仅连接其他兼容后端时需要填写
VITE_CAPTCHA_APP_ID=

# 开发和预览：留空时自动读取 server/.env 的 HOST / PORT
VITE_DEV_API_TARGET=

# Docker 对外网页端口；容器内 API 固定为 8788，无需映射到宿主机
WEB_HOST=127.0.0.1
WEB_PORT=8086

# Compose 拉取镜像的 Docker Hub 命名空间与标签；
# fork 后改成自己的账号，IMAGE_TAG 可固定到某个发行版本，如 v1.0.0
IMAGE_NAMESPACE=yatotm1994
IMAGE_TAG=latest
